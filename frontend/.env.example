# ==============================================================================
# Retrivox Frontend — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' in the 'frontend/' directory.
# Vite automatically exposes variables prefixed with 'VITE_'.
# ==============================================================================

# --- Backend API Base URL ---
# Local development default:
VITE_API_BASE_URL=http://localhost:8080

# Production example (e.g. your cloud backend URL):
# VITE_API_BASE_URL=https://api.retrivox.yourdomain.com
