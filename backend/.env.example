# ==============================================================================
# Retrivox Backend — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' or configure these environment variables in your
# deployment environment / IDE run configuration.
# NEVER commit your actual passwords, secrets, or API keys to version control.
# ==============================================================================

# --- Database Connection (PostgreSQL / Supabase) ---
# Example for Supabase Session Pooler (port 5432 or 6543):
# jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=your_secure_database_password_here

# --- LLM API Configuration (OpenAI or Any OpenAI-Compatible Provider) ---
# Supports OpenAI, Groq, OpenRouter, Together AI, or local Ollama.
LLM_API_KEY=your_openai_or_compatible_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1000
LLM_MAX_INPUT_CHARS=120000

# --- Vector Embeddings Configuration (for RAG Document Q&A) ---
# Default inherits LLM_API_KEY and LLM_BASE_URL if left empty.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=3

# --- Security & JWT Authentication ---
# Generate a secure 256-bit (32+ character) random string for production HMAC-SHA256
JWT_SECRET=your-minimum-32-character-secret-key-for-jwt-signing-here
# Expiration time in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# --- Server Port (Optional, default: 8080) ---
SERVER_PORT=8080
